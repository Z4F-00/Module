local TweenService = game:GetService("TweenService")
local TSPlus = {}

local activeQueues = {}
setmetatable(activeQueues, {__mode = "k"})

local TAG_PATTERN = "(<[^>]+>)|([\1-\127\194-\244][\128-\191]*)"

local function getSegments(text)
    local segments = {totalChars = 0}
    for tag, char in text:gmatch(TAG_PATTERN) do
        if tag then
            table.insert(segments, {content = tag, isTag = true})
        else
            table.insert(segments, {content = char, isTag = false})
            segments.totalChars += 1
        end
    end
    return segments
end

local function applyTypewriter(segments, ratio)
    local result = ""
    local threshold = math.floor(segments.totalChars * ratio)
    local currentCount = 0

    for _, seg in ipairs(segments) do
        if seg.isTag then
            result ..= seg.content
        else
            if currentCount >= threshold then break end
            result ..= seg.content
            currentCount += 1
        end
    end
    return result
end

function TSPlus:Create(object, info, goals)
    local actualInfo = typeof(info) == "table" and TweenInfo.new(
        info.Time or 1,
        Enum.EasingStyle[info.Style or "Linear"],
        Enum.EasingDirection[info.Direction or "Out"]
    ) or info

    local textGoal = goals.Text
    local otherGoals = {}
    for prop, val in pairs(goals) do
        if prop ~= "Text" then otherGoals[prop] = val end
    end

    local mainTween = TweenService:Create(object, actualInfo, otherGoals)
    
    if textGoal == nil or not (object:IsA("TextLabel") or object:IsA("TextButton")) then
        return mainTween
    end

    local progress = Instance.new("NumberValue")
    local segments = getSegments(textGoal)
    local textTween = TweenService:Create(progress, actualInfo, {Value = 1})
    
    object.RichText = true
    
    local connection = progress.Changed:Connect(function(val)
        object.Text = applyTypewriter(segments, val)
    end)

    local function cleanup()
        if connection then connection:Disconnect(); connection = nil end
        textTween:Cancel()
        progress:Destroy()
    end

    local tweenProxy = {
        Instance = mainTween,
        PlaybackState = mainTween.PlaybackState,
        Completed = mainTween.Completed
    }

    function tweenProxy:Play()
        progress.Value = 0
        textTween:Play()
        mainTween:Play()
    end

    function tweenProxy:Cancel()
        cleanup()
        mainTween:Cancel()
    end

    mainTween.Completed:Connect(function()
        cleanup()
        object.Text = textGoal
    end)

    return tweenProxy
end

function TSPlus:PlayQueue(object, queueList, defaultConfig)
    defaultConfig = defaultConfig or {}
    if activeQueues[object] then activeQueues[object].cancelled = true end

    local session = { cancelled = false }
    activeQueues[object] = session

    task.spawn(function()
        for _, item in ipairs(queueList) do
            if session.cancelled or not object:IsDescendantOf(game) then break end

            local info = {
                Time = item.Time or defaultConfig.Time or 1,
                Style = item.Style or defaultConfig.Style or "Linear",
                Direction = item.Direction or defaultConfig.Direction or "Out"
            }
            
            local goals = {Text = item.Text}
            for k, v in pairs(item) do
                if k ~= "Time" and k ~= "Style" and k ~= "Direction" and k ~= "Delay" then
                    goals[k] = v
                end
            end

            local tween = self:Create(object, info, goals)
            tween:Play()
            
            tween.Completed:Wait()
            
            if session.cancelled then break end
            
            local delayTime = item.Delay or defaultConfig.Delay or 0
            if delayTime > 0 then task.wait(delayTime) end
        end
        if activeQueues[object] == session then activeQueues[object] = nil end
    end)
end

return TSPlus
